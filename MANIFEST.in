# Include documentation
include README.md
include LICENSE
include CHANGELOG.md
include QUICKSTART.md
include TROUBLESHOOTING.md
include DiT_vs_UNet_GUIDE.md
include CHEATSHEET.md
include ARCHITECTURE.md
include PROJECT_SUMMARY.md
include UPDATE_SUMMARY.md

# Include configuration files
include pyproject.toml
include requirements.txt
include setup.py
include MANIFEST.in

# Include configuration templates
recursive-include configs *.yaml *.yml *.json

# Include tests
recursive-include tests *.py

# Include examples
recursive-include examples *.py

# Exclude cache, models, and output directories
recursive-exclude cache *
recursive-exclude models *
recursive-exclude outputs *

# Exclude compiled Python files
global-exclude __pycache__
global-exclude *.py[cod]
global-exclude *$py.class

# Exclude development files
exclude .gitignore
exclude .pre-commit-config.yaml
recursive-exclude .git *
recursive-exclude .github *

# Exclude IDE files
recursive-exclude .vscode *
recursive-exclude .idea *
global-exclude .DS_Store